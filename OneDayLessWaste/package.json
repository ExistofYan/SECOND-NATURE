{
  "name": "one-day-less-waste",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1 --port 5174 --configLoader runner",
    "build": "node scripts/prepare-assets.mjs && vue-tsc --noEmit && vite build --configLoader runner && node scripts/prepare-public-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run --configLoader runner",
    "art": "node scripts/draw-scenes.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "jsqr": "^1.4.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^30.1.3",
    "qrcode": "^1.5.4",
    "typescript": "~5.7.3",
    "vite": "6.4.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
